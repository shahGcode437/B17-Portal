# Copy to `.env` (git-ignored) and adjust. Real values never go in this file.
# Settings are read by app/core/config.py; real environment variables override `.env`.

# development | test | staging | production
ENVIRONMENT=development

# More verbose logs (log level DEBUG) when true. Never changes what error responses reveal.
DEBUG=true

# Optional explicit log level (DEBUG, INFO, WARNING, ERROR, CRITICAL). Defaults from DEBUG.
# LOG_LEVEL=INFO

# Exact browser origins allowed by CORS, comma-separated: scheme://host[:port], no path, no "*".
# In `development` the two Vite origins below are the default when this is unset.
# Every other environment MUST set this explicitly to its deployed frontend origin(s).
# 127.0.0.1:4173 is the production-preview origin used by the Playwright E2E suite.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:4173

# Canonical localities a NEW listing's `area` must belong to (Phase 12D): comma-separated or a JSON
# list; matched trimmed and case-insensitively and stored in this spelling. Default `B-17`. This is a
# list, not a geofence: no geographic data is implied (docs/backend/LOCATION_MAP.md §4-§5).
# LOCALITIES=B-17

# --- Database ---------------------------------------------------------------------------------
# The application database (PostgreSQL via psycopg 3). These match `docker compose up -d db`
# (backend/compose.yaml): development-only credentials, loopback-only port 54329 (chosen so it
# never collides with a PostgreSQL installed on the machine). Never reuse them anywhere real.
DATABASE_URL=postgresql+psycopg://b17:b17_dev_password@127.0.0.1:54329/b17_dev

# Seconds to wait when opening a connection (keeps /health/ready quick to fail). Default 5.
# DB_CONNECT_TIMEOUT_SECONDS=5

# The database the automated tests are allowed to RESET. Read only by the test harness, never by
# the application. It must be a separate database whose name ends in `_test` on a local host, and
# it can never be the same as DATABASE_URL (tests/db_safety.py refuses anything else). The Compose
# database creates `b17_test` for you on first start.
TEST_DATABASE_URL=postgresql+psycopg://b17:b17_dev_password@127.0.0.1:54329/b17_test

# --- Authentication (Phase 11B; docs/backend/AUTH_RBAC.md) -------------------------------------
# Development topology: frontend http://127.0.0.1:5173 and API http://127.0.0.1:8000. Use 127.0.0.1
# for BOTH and never mix in `localhost` (cross-site: the session cookie would not be sent).
# The session cookie is `b17_session` (HttpOnly, SameSite=Lax, not Secure) in development and
# `__Host-b17_session` (also Secure, no Domain) in staging/production. There is no session secret,
# JWT key or token pepper: sessions and one-time tokens are random values stored only as SHA-256.
#
# Exact frontend origin used in email links (verification / reset). Defaults to
# http://127.0.0.1:5173 in development; REQUIRED in staging/production and must be one of
# FRONTEND_ORIGINS.
# FRONTEND_BASE_URL=http://127.0.0.1:5173
#
# Email delivery: `console` (prints the message and its link; development default), `memory`
# (tests) or `disabled` (the only value allowed in staging/production until a provider exists).
# EMAIL_BACKEND=console
# EMAIL_FROM=B-17 Portal <no-reply@localhost>
#
# Session lifetimes and the per-user cap (defaults shown; changing them needs a security review).
# SESSION_IDLE_DAYS=14
# SESSION_ABSOLUTE_DAYS=30
# ADMIN_SESSION_IDLE_MINUTES=120
# ADMIN_SESSION_MAX_HOURS=12
# MAX_SESSIONS_PER_USER=10
#
# Argon2id (defaults: RFC 9106 low-memory profile). Staging/production refuse values below the
# OWASP floor (memory >= 19456 KiB, time cost >= 2). Lower values are for fast local tests only.
# PASSWORD_HASH_TIME_COST=3
# PASSWORD_HASH_MEMORY_COST_KIB=65536
# PASSWORD_HASH_PARALLELISM=4
# MAX_CONCURRENT_PASSWORD_HASHES=4
#
# AUTH_COOKIE_SECURE defaults to true outside development/test and cannot be false when hosted.
# AUTH_COOKIE_SECURE=false

# --- Google sign-in (Phase 11C; docs/backend/AUTH_RBAC.md §10, DEPLOYMENT.md) --------------------
# GOOGLE_OAUTH_PROVIDER: `disabled` (default; the OAuth endpoints answer 503), `fake` (an in-process
# stand-in for Google, development/test ONLY — refused in staging/production; no network, no
# credentials) or `google` (the real thing; needs the three values below).
# GOOGLE_OAUTH_PROVIDER=disabled
#
# The OAuth client of type "Web application" created in Google Cloud Console. The client id is not
# a secret; the client secret is — set it only in the real environment / the host's secret store,
# never in a committed file. Leave both empty for `disabled` and `fake`.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
#
# The public base URL of THIS API as the browser reaches it (scheme://host[:port], no path). The
# callback registered in Google Cloud must be exactly
#   <API_PUBLIC_BASE_URL>/api/v1/auth/oauth/google/callback
# Defaults to http://127.0.0.1:8000 in development; REQUIRED (https) when Google sign-in is
# enabled in staging/production.
# API_PUBLIC_BASE_URL=http://127.0.0.1:8000

# API_V1_PREFIX=/api/v1
# APP_NAME=B-17 Portal API
# APP_VERSION=   # defaults to the installed package version
