# Copy to `.env` (git-ignored) and adjust. Real values never go in this file.
# Settings are read by app/core/config.py; real environment variables override `.env`.

# development | test | staging | production
ENVIRONMENT=development

# More verbose logs (log level DEBUG) when true. Never changes what error responses reveal.
DEBUG=true

# Optional explicit log level (DEBUG, INFO, WARNING, ERROR, CRITICAL). Defaults from DEBUG.
# LOG_LEVEL=INFO

# Exact browser origins allowed by CORS, comma-separated: scheme://host[:port], no path, no "*".
# In `development` the two Vite origins below are the default when this is unset.
# Every other environment MUST set this explicitly to its deployed frontend origin(s).
# 127.0.0.1:4173 is the production-preview origin used by the Playwright E2E suite.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:4173

# --- Database ---------------------------------------------------------------------------------
# The application database (PostgreSQL via psycopg 3). These match `docker compose up -d db`
# (backend/compose.yaml): development-only credentials, loopback-only port 54329 (chosen so it
# never collides with a PostgreSQL installed on the machine). Never reuse them anywhere real.
DATABASE_URL=postgresql+psycopg://b17:b17_dev_password@127.0.0.1:54329/b17_dev

# Seconds to wait when opening a connection (keeps /health/ready quick to fail). Default 5.
# DB_CONNECT_TIMEOUT_SECONDS=5

# The database the automated tests are allowed to RESET. Read only by the test harness, never by
# the application. It must be a separate database whose name ends in `_test` on a local host, and
# it can never be the same as DATABASE_URL (tests/db_safety.py refuses anything else). The Compose
# database creates `b17_test` for you on first start.
TEST_DATABASE_URL=postgresql+psycopg://b17:b17_dev_password@127.0.0.1:54329/b17_test

# API_V1_PREFIX=/api/v1
# APP_NAME=B-17 Portal API
# APP_VERSION=   # defaults to the installed package version
