# Copy to `.env` (git-ignored) and adjust. Real values never go in this file.
# Settings are read by app/core/config.py; real environment variables override `.env`.

# development | test | staging | production
ENVIRONMENT=development

# More verbose logs (log level DEBUG) when true. Never changes what error responses reveal.
DEBUG=true

# Optional explicit log level (DEBUG, INFO, WARNING, ERROR, CRITICAL). Defaults from DEBUG.
# LOG_LEVEL=INFO

# Exact browser origins allowed by CORS, comma-separated: scheme://host[:port], no path, no "*".
# In `development` the two Vite origins below are the default when this is unset.
# Every other environment MUST set this explicitly to its deployed frontend origin(s).
# 127.0.0.1:4173 is the production-preview origin used by the Playwright E2E suite.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:4173

# API_V1_PREFIX=/api/v1
# APP_NAME=B-17 Portal API
# APP_VERSION=   # defaults to the installed package version
