# Optional build-time configuration (copy to .env.production.local; never commit real .env files).

# Public production URL, no trailing slash. When set, canonical / og:url / og:image use it and the build
# also writes dist/sitemap.xml and adds the `Sitemap:` line to robots.txt. When unset, the page's own
# origin is used and no sitemap is generated (no domain is hard-coded anywhere).
# VITE_SITE_URL=https://example.org

# Set to "true" for staging / demo deployments: every route is served `noindex, nofollow` and canonical
# is omitted (all current listing data is fictional demo content).
# VITE_SITE_NOINDEX=true

# Base URL of the B-17 API (Phase 12C), no trailing slash. Safe placeholder only; never put secrets in a VITE_ variable
# (everything prefixed VITE_ is shipped to the browser).
#  - Development default when unset: http://127.0.0.1:8000/api/v1 — use 127.0.0.1 for BOTH the frontend (:5173) and the API
#    (:8000); mixing in `localhost` makes the session cookie cross-site and it will not be sent.
#  - Production default when unset: same-origin /api/v1 (the API reverse-proxied next to the frontend).
# VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
